# ==============================================================================
# BUSCAPROMO API - PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# Instrucciones: Copia este archivo como '.env' dentro del directorio /backend
# y reemplaza los valores de ejemplo con tus credenciales reales.
# ==============================================================================

# Configuración general del servicio
PROJECT_NAME=Buscapromo API
VERSION=1.0.0
ENVIRONMENT=development

# Cadena de conexión a MongoDB Atlas (Mínimo 20 caracteres, esquema mongodb+srv://)
MONGODB_URL=mongodb+srv://<USUARIO>:<PASSWORD>@<CLUSTER>.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=buscapromo_db

# Parámetros criptográficos para firma de tokens JWT (Mínimo 16 caracteres)
JWT_SECRET_KEY=reemplazar_por_clave_secreta_segura_minimo_16_caracteres
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Identificador opcional de proyecto para despliegue en Google Cloud Platform
GCP_PROJECT_ID=buscapromo-utn-2026